<?xml version="1.0" encoding="utf-8"?>
<!-- CamAnime talks to its own HTTPS API and to HTTPS media CDNs only. Cleartext
     is refused at the platform level, so a hijacked proxy or a downgraded
     stream URL fails closed instead of leaking a session token in the clear. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
