<Window x:Class="CamAnime.Windows.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CamAnime Library — Save to device"
        Height="520" Width="820" Background="#07080D" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top" Foreground="#F3F5FA" FontWeight="Bold" FontSize="16"
               Text="My Library (hidden in-app)" Margin="0,0,0,4" />
    <TextBlock DockPanel.Dock="Top" Foreground="#64708A" FontSize="11" Margin="0,0,0,10"
               Text="Downloads are stored inside the app only. Pick an item and use Save to device to export it." />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Save to device" Padding="14,6" Margin="0,0,8,0" Click="Save_Click"
              Background="#10B981" Foreground="#052E16" BorderBrush="#10B981" />
      <Button Content="Delete from library" Padding="14,6" Click="Delete_Click"
              Background="#141926" Foreground="White" BorderBrush="#2A3245" />
    </StackPanel>

    <ListBox x:Name="Files" Background="#0E111A" Foreground="#F3F5FA" BorderBrush="#2A3245" />
  </DockPanel>
</Window>
