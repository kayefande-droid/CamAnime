<Window x:Class="CamAnime.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CamAnime — Free Anime Streaming (Windows)"
        Height="820" Width="1360" MinHeight="480" MinWidth="360"
        Background="#07080D" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#0E111A" Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="4,0,12,0"
                   FontWeight="Bold" FontSize="15" Foreground="#FFB347" Text="CamAnime" />

        <TextBox Grid.Column="1" x:Name="AddressBox" VerticalAlignment="Center" Height="30"
                 Background="#141926" Foreground="White" BorderBrush="#2A3245"
                 KeyDown="Address_KeyDown" />

        <Button Grid.Column="2" Content="◀" Width="36" Height="30" Margin="8,0,0,0" Click="Back_Click" Background="#141926" Foreground="White" BorderBrush="#2A3245" />
        <Button Grid.Column="3" Content="▶" Width="36" Height="30" Margin="6,0,0,0" Click="Forward_Click" Background="#141926" Foreground="White" BorderBrush="#2A3245" />
        <Button Grid.Column="4" Content="⟳" Width="36" Height="30" Margin="6,0,0,0" Click="Reload_Click" Background="#141926" Foreground="White" BorderBrush="#2A3245" />
        <Button Grid.Column="5" Content="Library" Height="30" Margin="6,0,0,0" Padding="10,0" Click="Library_Click" Background="#10B981" Foreground="#052E16" BorderBrush="#10B981" />

      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#0E111A" Padding="10,6">
      <TextBlock x:Name="StatusText" Foreground="#64708A" FontSize="11"
                 Text="Downloads stay inside this app's library until you use Save to device. Made by kayefande-droid &amp; co." />
    </Border>

    <wv2:WebView2 x:Name="Web" />
  </DockPanel>
</Window>
