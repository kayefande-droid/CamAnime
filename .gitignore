mobile/camanime_app/android/.kotlin/
# App binaries ship via GitHub Releases — keep them out of git so the
# Render slug stays under the size limit. /download and /get/* fall back
# to the Release asset automatically (see docs/APP_RELEASES.md).
static/downloads/*.apk
static/downloads/*.zip
static/downloads/*.exe
mobile/camanime_app/build_log*.txt
mobile/apk/
.shots/
# Owner-only runbooks, signing material, local hosting secrets and generated
# binaries. Hosting (Render/Cloudflare) never needs these tracked; their
# deployment configs stay in render.yaml and cloudflare/.
# Ephemeral Render API artifacts (do not track).
deploy_id.txt
render_latest.json
render_one.json
docs/private/
*.keystore
*.jks
*.p12
*.pem
key.properties
cloudflare/.dev.vars
.wrangler/
**/service-account*.json
/downloads/
ffmpeg-bin
render_env.json

