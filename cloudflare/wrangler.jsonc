// CamAnime-independent Cloudflare Worker configuration (worker name: camanjme).
// Deployed from this folder via `npx wrangler deploy` (or Workers Builds, root /cloudflare, main).
// Bindings: DB = Cloudflare D1 (own database), FILES = R2 bucket (own storage),
// ASSETS = the repository's real static assets (same CSS/JS/icons as Render).
// Secrets/vars are documented in README.md.
{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "camanjme",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,

  // Workers Logs + Traces: streaming download failures upstream (rotating
  // provider domains) are otherwise invisible in production.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },

  // Defaults the worker reads at runtime. Override per environment in the
  // dashboard (Settings → Variables) without editing code.
  "vars": {
    "APP_VERSION": "2.13.0",
    // Leave empty to keep /admin a 404, matching the Render origin's
    // CAMANIME_ADMIN_PATH policy. Set it to serve the private dashboard.
    "ADMIN_PATH": "/owner-console",
    // Public identifier of the Firebase project used for FCM (not a secret;
    // the service-account key is set with `wrangler secret put FCM_SERVICE_ACCOUNT`).
    "FCM_PROJECT_ID": ""
  },

  // Hourly new-episode digest. FCM delivers to devices with the app closed or
  // the screen off; a run with nothing airing sends nothing at all.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "camanime",
      "database_id": "23847663-1064-422b-a12d-e3d602a9c745",
      "migrations_dir": "migrations"
    }
  ],

  // R2 is NOT yet activated on account e808f37c…: the API answers
  // "Please enable R2 through the Cloudflare Dashboard", and a Wrangler deploy
  // with an R2 binding fails while the bucket does not exist. Every FILES use
  // in src/ is already guarded (`if (env.FILES)`), so the worker runs without
  // it: downloads fall back to the static asset bundle and then to the Render
  // 302. Re-enable this binding after activating R2 and creating the bucket.
  //
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "camanime"
    }
  ],

  "assets": {
    "directory": "../static",
    "binding": "ASSETS",
    "not_found_handling": "none"
  }
}
